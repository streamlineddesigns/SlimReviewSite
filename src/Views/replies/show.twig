{% extends "app.twig" %}

{% block title %}Replies Show{% endblock %}

{% block content %}

    {% if reply[0] %}

    <a href="javascript:FunApp.backButtonClick()" class="btn btn-success mb-5"><i class="bi bi-chevron-left"></i> Back</a>

        <div class="card bg-dark text-white text-center">
            <div class="card-header">
                <h2>Reply Details</h2>
                <hr>
            </div>
            <div class="card-body">
                <h5 class="card-title">{{ reply[0].name }}</h5>
                <div class="card-text">
                    <label for="text" class="form-label float-left">Reply Text</label>
                    <textarea rows="5" type="text" class="form-control" name="text" disabled>{{ reply[0].text }}</textarea>
                    <div class="form-group mt-5 text-left">
                        <label class="form-label" for="viewMultiSelect">Review Categories</label>
                        <div class="form-control select-faker" id="viewMultiSelect">
                            {% if reviewCategories %}
                                {% for reviewCategory in reviewCategories %}
                                    <option value="{{reviewCategory.id}}" {% if inArray(reviewCategory.id, reply_review_categories) %} class="selected-option" {% endif %}>{{reviewCategory.name}}</option>
                                {% endfor %}
                            {% endif %}
                        </div>
                    </div>
                </div>
                <a class="btn btn-primary edit-btn mt-5" href="{{ reply[0].id }}/edit"><i class="bi bi-pencil"></i> Edit</a>
            </div>
            <div class="card-footer">
                <hr>
                Created: {{ reply[0].created_at|format_datetime() }}
            </div>
        </div>
    {% else %}
        <div class="text-center">No reply found by specified id.</div>
    {% endif %}

{% endblock %}