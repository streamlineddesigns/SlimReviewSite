{% extends "app.twig" %}

{% block headAssets %}<script src="https://unpkg.com/sweetalert/dist/sweetalert.min.js"></script>{% endblock %}
{% block title %}Review Categories Index{% endblock %}

{% block content %}
    
    {% if hasMessages() %}
        {% if successMessage() %}
            <script>swal("Success!", "{{successMessage()}}", "success");</script>
        {% elseif errorMessage() %}
            <script>swal("Error!", "{{errorMessage()}}", "error");</script>
        {% endif %}
    {% endif %}

    <a href="reviewCategories/create" class="btn btn-success mb-5 float-right"><i class="bi bi-plus"></i> New</a>

    {% if reviewCategories %}
        <table class="table table-striped table-dark table-bordered table-responsive" data-toggle="table" data-pagination="true" data-search="true">
            <thead>
                <tr>
                    <th class="mobile-hidden" data-sortable="true">ID</th>
                    <th data-sortable="true">Name</th>
                    <th class="mobile-hidden text-center" data-sortable="true">Created</th>
                    <th class="actions"></th>
                </tr>
            </thead>
            <tbody>
            {% for reviewCategory in reviewCategories %}

                <tr>
                    <td class="mobile-hidden">
                        {{ reviewCategory.id }}
                    </td>
                    <td class="">
                        {{ reviewCategory.name }}
                    </td>
                    <td class="mobile-hidden text-center">
                        {{ reviewCategory.created_at|date("m/d/Y") }}
                    </td>
                    <td class="mobile-td text-center">
                        <a href="reviewCategories/{{ reviewCategory.id }}/edit" class="btn btn-primary"><i class="bi bi-pencil"></i><span class="mobile-hidden"> Edit</span></a>
                        <a href="reviewCategories/{{ reviewCategory.id }}" class="btn btn-secondary"><i class="bi bi-eye"></i><span class="mobile-hidden"> View</span></a>
                        <a href="javascript:FunApp.deleteResource({{ reviewCategory.id }}, 'Review Category', 'delete-form-{{ reviewCategory.id }}')" class="btn btn-danger"><i class="bi bi-trash"></i><span class="mobile-hidden"> Delete</span></a>
                        <form method="post" action="/reviewCategories/{{ reviewCategory.id }}/delete" id="delete-form-{{ reviewCategory.id }}"></form>
                    </td>
                </tr>

            {% endfor %}
            </tbody>
        </table>
    {% else %}
        No Review Categories found.
    {% endif %}

{% endblock %}