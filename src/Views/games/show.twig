{% extends "app.twig" %}

{% block title %}Games Show{% endblock %}

{% block content %}

    {% if game[0] %}

    <a href="javascript:FunApp.backButtonClick()" class="btn btn-success mb-5"><i class="bi bi-chevron-left"></i> Back</a>

        <div class="card bg-dark text-white text-center">
            <div class="card-header">
                <h2>Game Details</h2>
                <hr>
            </div>
            <div class="card-body">
                <h5 class="card-title">{{ game[0].name }}</h5>
                <div class="card-text">
                    <label for="name" class="form-label float-left">Name</label>
                    <input type="text" class="form-control" name="name" value="{{ game[0].name }}" disabled>
                    <div class="form-group mt-5 text-left">
                        <label class="form-label" for="viewMultiSelect">Select Platforms</label>
                        <div class="form-control select-faker" id="viewMultiSelect">
                            {% if platforms %}
                                {% for platform in platforms %}
                                    <option value="{{platform.id}}" {% if inArray(platform.id, game_platforms) %} class="selected-option" {% endif %}>{{platform.name}}</option>
                                {% endfor %}
                            {% endif %}
                        </div>
                    </div>
                </div>
                <a class="btn btn-primary edit-btn mt-5" href="{{ game[0].id }}/edit"><i class="bi bi-pencil"></i> Edit</a>
            </div>
            <div class="card-footer">
                <hr>
                Created: {{ game[0].created_at|format_datetime() }}
            </div>
        </div>
    {% else %}
        <div class="text-center">No game found by specified id.</div>
    {% endif %}

{% endblock %}