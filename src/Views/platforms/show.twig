{% extends "app.twig" %}

{% block title %}Platforms Show{% endblock %}

{% block content %}

    {% if platform[0] %}

    <a href="javascript:FunApp.backButtonClick()" class="btn btn-success mb-5"><i class="bi bi-chevron-left"></i> Back</a>

        <div class="card bg-dark text-white text-center">
            <div class="card-header">
                <h2>Platform Details</h2>
                <hr>
            </div>
            <div class="card-body">
                <h5 class="card-title">{{ platform[0].name }}</h5>
                <div class="card-text">
                    <label for="name" class="form-label float-left">Name</label>
                    <input type="text" class="form-control" name="name" value="{{ platform[0].name }}" disabled>
                </div>
                <a class="btn btn-primary edit-btn mt-5" href="{{ platform[0].id }}/edit"><i class="bi bi-pencil"></i> Edit</a>
            </div>
            <div class="card-footer">
                <hr>
                Created: {{ platform[0].created_at|format_datetime() }}
            </div>
        </div>
    {% else %}
        <div class="text-center">No platform found by specified id.</div>
    {% endif %}

{% endblock %}